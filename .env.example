# Copy to .env and fill in. Values already exported in the real environment
# take precedence over this file.

# Required. Get one from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional. SQLite file, created on first run along with its directory.
DATABASE_PATH=data/timetracker.db

# Optional. One of debug, info, warn, error.
LOG_LEVEL=info
